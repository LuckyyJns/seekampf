# API-Schluessel von seekampf.de (Konto -> API-Keys). Derselbe Key wie beim
# Upgrade-Bot funktioniert, ein eigener ist aber uebersichtlicher.
SEEKAMPF_API_KEY=sk_live_...

# Telegram-Morgenreport (optional). Bot bei @BotFather anlegen, dem Bot einmal
# /start schicken, chat_id ueber https://api.telegram.org/bot<TOKEN>/getUpdates.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=123456789

# Schnittstelle fuer den Seekampf-Hub - bleibt lokal, die Seite im Heimnetz
# liefert der Seekampf-Hub (Port 8080) aus.
# FLOTTEN_MANAGER_HOST=127.0.0.1
# FLOTTEN_MANAGER_PORT=8081
