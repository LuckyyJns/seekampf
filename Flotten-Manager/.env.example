# API-Schluessel von seekampf.de (Konto -> API-Keys). Derselbe Key wie beim
# Ressourcen-Bot funktioniert, ein eigener ist aber uebersichtlicher.
SEEKAMPF_API_KEY=sk_live_...

# Telegram-Morgenreport (optional). Bot bei @BotFather anlegen, dem Bot einmal
# /start schicken, chat_id ueber https://api.telegram.org/bot<TOKEN>/getUpdates.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=123456789

# Weboberflaeche. 0.0.0.0 = im ganzen Heimnetz erreichbar (so gewuenscht).
# Auf 127.0.0.1 setzen, wenn nur der Pi selbst zugreifen soll.
# FLOTTEN_MANAGER_HOST=0.0.0.0
# FLOTTEN_MANAGER_PORT=8080
