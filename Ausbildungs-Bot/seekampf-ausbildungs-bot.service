[Unit]
Description=Seekampf Ausbildungs-Bot (Truppen je Insel auf Soll)
After=network-online.target
Wants=network-online.target
# Bei einer Absturzschleife nach 5 Starts in 10 Minuten aufgeben, statt endlos
# neu zu starten - erst dann gilt der Dienst als "failed".
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=seekampf-ausbildungs-bot-alert.service

[Service]
Type=simple
User=jannishoy
WorkingDirectory=/home/jannishoy/Seekampf/Ausbildungs-Bot
ExecStart=/home/jannishoy/Seekampf/Ausbildungs-Bot/.venv/bin/python /home/jannishoy/Seekampf/Ausbildungs-Bot/web.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
