SEEKAMPF_API_KEY=sk_live_...

# Optional: falls /me keine vollstaendige Inselliste liefert, hier
# eine kommagetrennte Liste von Insel-IDs als Notfall-Override eintragen.
# SEEKAMPF_ISLAND_IDS_OVERRIDE=12,13,27

# Telegram-Morgenreport (optional, um 7 Uhr): Bot bei @BotFather anlegen,
