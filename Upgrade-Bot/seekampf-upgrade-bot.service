[Unit]
Description=Seekampf Upgrade-Bot
After=network-online.target
Wants=network-online.target
# Bei einer Absturzschleife nach 5 Starts in 10 Minuten aufgeben, statt endlos
# alle 10s neu zu starten - erst dann gilt der Dienst als "failed" und loest
# den Telegram-Alarm aus.
StartLimitIntervalSec=600
StartLimitBurst=5
OnFailure=seekampf-upgrade-bot-alert.service

[Service]
Type=simple
User=jannishoy
WorkingDirectory=/home/jannishoy/Seekampf/Upgrade-Bot
ExecStart=/home/jannishoy/Seekampf/Upgrade-Bot/.venv/bin/python /home/jannishoy/Seekampf/Upgrade-Bot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
